[
  {
    "id": "bot-is-not-a-reply",
    "rule": "An automated verification code 30 seconds after the member writes is not the first response.",
    "messages": [
      ["c1", "m1", "member", null, "I can't log in", "2026-10-04T10:00:00Z"],
      ["c1", "m1", "agent", "Sara", "Your verification code is 482913", "2026-10-04T10:00:30Z"],
      ["c1", "m1", "agent", "Omar", "Fixed, please try again", "2026-10-04T10:30:00Z"]
    ],
    "now": "2026-10-04T12:00:00Z",
    "expect": {"c1#1": {"replied": true, "first_response_min": 30.0, "first_response_business_min": 30.0, "agent": "Omar",
                        "sla_met": true, "sla_breached": false, "waiting": false, "topic": "access"}}
  },
  {
    "id": "after-hours-counts-business-time",
    "rule": "Thursday 17:50 to Sunday 09:10 is 63h20m on the calendar but 20 business minutes (Sun-Thu 09:00-18:00).",
    "messages": [
      ["c1", "m1", "member", null, "How do I join the live session?", "2026-10-01T17:50:00Z"],
      ["c1", "m1", "agent", "Mona", "Here is the link", "2026-10-04T09:10:00Z"]
    ],
    "now": "2026-10-04T12:00:00Z",
    "expect": {"c1#1": {"first_response_min": 3800.0, "first_response_business_min": 20.0, "sla_met": true,
                        "topic": "events"}}
  },
  {
    "id": "unanswered-breaches-sla-and-alerts",
    "rule": "An unanswered contact breaches the SLA once its business age passes the target, and is in the alert queue.",
    "config": {"sla_first_response_minutes": 60, "alert_after_minutes": 90},
    "messages": [["c1", "m1", "member", null, "Is there a student discount?", "2026-10-04T10:00:00Z"]],
    "now": "2026-10-04T12:00:00Z",
    "expect": {"c1#1": {"replied": false, "sla_met": null, "sla_breached": true, "waiting": true,
                        "waiting_since": "2026-10-04T10:00:00Z", "waiting_business_min": 120.0, "topic": "plans"}},
    "expect_queue": [{"contact_id": "c1#1", "alert": true}]
  },
  {
    "id": "unanswered-inside-sla-is-not-yet-a-breach",
    "rule": "Unanswered for 30 business minutes with a 60-minute target: waiting, not breached, no alert.",
    "messages": [["c1", "m1", "member", null, "Hello?", "2026-10-04T10:00:00Z"]],
    "now": "2026-10-04T10:30:00Z",
    "expect": {"c1#1": {"sla_met": null, "sla_breached": false, "waiting": true, "waiting_business_min": 30.0}},
    "expect_queue": [{"contact_id": "c1#1", "alert": false}]
  },
  {
    "id": "returning-member-is-a-new-contact",
    "rule": "The member comes back two days after a reply: a second contact with its own response time.",
    "messages": [
      ["c1", "m1", "member", null, "Login problem", "2026-10-04T10:00:00Z"],
      ["c1", "m1", "agent", "Omar", "Done", "2026-10-04T10:20:00Z"],
      ["c1", "m1", "member", null, "I need an invoice for my payment", "2026-10-06T11:00:00Z"],
      ["c1", "m1", "agent", "Sara", "Sent", "2026-10-06T13:00:00Z"]
    ],
    "now": "2026-10-07T10:00:00Z",
    "expect": {"c1#1": {"first_response_min": 20.0, "topic": "access", "sla_met": true},
               "c1#2": {"first_response_min": 120.0, "first_response_business_min": 120.0, "agent": "Sara",
                        "sla_met": false, "sla_breached": true, "topic": "billing"}},
    "expect_kpis": {"contacts": 2, "replied": 2, "sla_breaches": 1, "sla_met_rate": 0.5}
  },
  {
    "id": "follow-up-inside-the-gap-stays-one-contact",
    "rule": "A new question 20 minutes after a reply is the same contact, and it is waiting again.",
    "messages": [
      ["c1", "m1", "member", null, "Where is the recording?", "2026-10-04T10:00:00Z"],
      ["c1", "m1", "agent", "Mona", "In the library", "2026-10-04T10:10:00Z"],
      ["c1", "m1", "member", null, "And the slides?", "2026-10-04T10:30:00Z"]
    ],
    "now": "2026-10-04T11:00:00Z",
    "expect": {"c1#1": {"first_response_min": 10.0, "waiting": true, "waiting_since": "2026-10-04T10:30:00Z",
                        "waiting_business_min": 30.0}},
    "expect_kpis": {"contacts": 1, "waiting_on_reply": 1}
  },
  {
