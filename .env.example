# Copy to .env. Never commit .env.
SA_DB_PATH=data/support.db
# Business hours, SLA, topics and prices (see workspace.example.json)
# SA_CONFIG_PATH=workspace.json
# Push endpoint keys (JSON list). Leave empty to keep POST /api/ingest and /api/sync disabled.
# SA_API_KEYS=["change-me-to-a-long-random-key"]
# Scheduled import: synthetic, csv:<folder> or json:<file>, every N seconds
# SA_SYNC_SOURCE=csv:./exports
# SA_SYNC_INTERVAL_S=900
